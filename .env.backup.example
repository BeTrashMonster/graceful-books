# ============================================================================
# Audacious Money - S3 Backup Storage Configuration
# ============================================================================
#
# This file contains environment variables for the backup storage system.
# Copy this file to `.env.backup` and fill in your actual values.
#
# IMPORTANT: Never commit .env.backup to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# AWS Configuration
# ----------------------------------------------------------------------------

# AWS Region where S3 bucket is located
AWS_REGION=us-east-1

# S3 Bucket name for backup storage
# Format: audacious-money-backup-storage-[environment]
# Examples:
#   - Production: audacious-money-backup-storage-prod
#   - Staging: audacious-money-backup-storage-staging
#   - Development: audacious-money-backup-storage-dev
AWS_S3_BACKUP_BUCKET=audacious-money-backup-storage-dev

# KMS Key ID for server-side encryption
# Format: arn:aws:kms:[region]:[account-id]:key/[key-id]
# Or just the key ID: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AWS_S3_BACKUP_KMS_KEY_ID=

# ----------------------------------------------------------------------------
# AWS Credentials
# ----------------------------------------------------------------------------
#
# PRODUCTION: Use IAM roles (EC2/ECS/Lambda) instead of access keys
# DEVELOPMENT: Use access keys for local development only
# ----------------------------------------------------------------------------

# AWS Access Key ID (leave empty if using IAM role)
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key (leave empty if using IAM role)
AWS_SECRET_ACCESS_KEY=

# AWS Session Token (optional, for temporary credentials)
AWS_SESSION_TOKEN=

# ----------------------------------------------------------------------------
# Backup Storage Settings
# ----------------------------------------------------------------------------

# How many days to retain backups before automatic deletion (default: 7)
BACKUP_RETENTION_DAYS=7

# Maximum backup file size in MB (default: 100)
BACKUP_MAX_SIZE_MB=100

# Enable backup compression before upload (true/false, default: true)
BACKUP_ENABLE_COMPRESSION=true

# Backup file naming prefix (optional, default: "backup")
BACKUP_FILE_PREFIX=backup

# ----------------------------------------------------------------------------
# Email Backup Settings
# ----------------------------------------------------------------------------

# Enable email backup feature (true/false, default: false)
EMAIL_BACKUP_ENABLED=false

# Email service provider (sendgrid, ses, smtp)
EMAIL_SERVICE_PROVIDER=ses

# SendGrid API Key (if using SendGrid)
SENDGRID_API_KEY=

# AWS SES Configuration (if using SES)
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=backups@audaciousmoney.com
AWS_SES_FROM_NAME=Audacious Money Backups

# SMTP Configuration (if using SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# Restoration Token Settings
# ----------------------------------------------------------------------------

# Token expiration in days (default: 7)
RESTORATION_TOKEN_EXPIRATION_DAYS=7

# Maximum failed validation attempts before rate limiting (default: 5)
RESTORATION_TOKEN_MAX_ATTEMPTS=5

# Rate limit window in hours (default: 1)
RESTORATION_TOKEN_RATE_LIMIT_HOURS=1

# Base URL for restoration links (e.g., https://app.audaciousmoney.com)
RESTORATION_BASE_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------------

# Enforce HTTPS for all S3 operations (true/false, default: true)
S3_ENFORCE_SSL=true

# Enable S3 server-side encryption validation (true/false, default: true)
S3_ENFORCE_ENCRYPTION=true

# Enable audit logging for all backup operations (true/false, default: true)
BACKUP_AUDIT_LOGGING_ENABLED=true

# ----------------------------------------------------------------------------
# Performance Settings
# ----------------------------------------------------------------------------

# S3 upload part size for multipart uploads (MB, default: 5)
S3_UPLOAD_PART_SIZE_MB=5

# S3 upload concurrency (parallel parts, default: 4)
S3_UPLOAD_CONCURRENCY=4

# S3 download part size for multipart downloads (MB, default: 5)
S3_DOWNLOAD_PART_SIZE_MB=5

# S3 request timeout (seconds, default: 60)
S3_REQUEST_TIMEOUT_SECONDS=60

# ----------------------------------------------------------------------------
# Monitoring & Alerts
# ----------------------------------------------------------------------------

# CloudWatch Logs group name
CLOUDWATCH_LOG_GROUP=/aws/audacious-money/backup-service

# CloudWatch Logs stream name
CLOUDWATCH_LOG_STREAM=backup-operations

# Enable CloudWatch metrics (true/false, default: true)
CLOUDWATCH_METRICS_ENABLED=true

# SNS Topic ARN for backup alerts (optional)
SNS_BACKUP_ALERTS_TOPIC_ARN=

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------

# Enable debug logging (true/false, default: false)
DEBUG_BACKUP_SERVICE=false

# Enable S3 operation logging (true/false, default: false)
DEBUG_S3_OPERATIONS=false

# Use LocalStack for local S3 testing (true/false, default: false)
USE_LOCALSTACK=false

# LocalStack S3 endpoint (if USE_LOCALSTACK=true)
LOCALSTACK_S3_ENDPOINT=http://localhost:4566

# ----------------------------------------------------------------------------
# Cost Optimization
# ----------------------------------------------------------------------------

# Enable S3 Intelligent-Tiering (true/false, default: false)
# Note: Only enable if backups vary significantly in access patterns
S3_INTELLIGENT_TIERING=false

# Enable S3 Transfer Acceleration (true/false, default: false)
# Note: Adds cost but improves upload/download speed for global users
S3_TRANSFER_ACCELERATION=false

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
#
# 1. Security: Never commit this file with real credentials to version control
# 2. IAM Roles: Prefer IAM roles over access keys in production
# 3. KMS Keys: Use customer-managed keys (CMK) for encryption
# 4. Monitoring: Enable CloudWatch for production deployments
# 5. Testing: Use LocalStack for local development and testing
# 6. Cost: Monitor S3 storage and data transfer costs regularly
#
# For detailed setup instructions, see: docs/S3_BACKUP_STORAGE_SETUP.md
# ============================================================================
