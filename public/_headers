# HTTP Security and Cache Control Headers for Audacious Money
# Cloudflare Pages automatically applies these headers
# Updated: 2026-03-22

# SECURITY HEADERS (Applied to all routes)
# These headers protect against XSS, clickjacking, and other web vulnerabilities
/*
  # Content Security Policy - Prevents XSS and data injection attacks
  # Note: More restrictive than dev mode (no 'unsafe-eval')
  # Stripe domains: js.stripe.com, api.stripe.com
  # API domains: api.audacious.money, sync.audacious.money
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; connect-src 'self' https://api.audacious.money wss://sync.audacious.money https://api.stripe.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://js.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'

  # X-Frame-Options - Prevents clickjacking (DENY = cannot be framed by any site)
  X-Frame-Options: DENY

  # X-Content-Type-Options - Prevents MIME type sniffing
  X-Content-Type-Options: nosniff

  # X-XSS-Protection - Legacy XSS protection for older browsers
  X-XSS-Protection: 1; mode=block

  # Strict-Transport-Security - Forces HTTPS connections (31536000 seconds = 1 year)
  # includeSubDomains: applies to all subdomains
  # preload: eligible for browser HSTS preload list
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Referrer-Policy - Controls referrer information disclosure
  # strict-origin-when-cross-origin: send full URL to same origin, only origin to cross-origin
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions-Policy - Restricts browser feature access
  # Denies access to geolocation, microphone, and camera (not needed for financial app)
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# HTML - Never cache (always check for updates)
# This ensures users always get the latest version of the app
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# JavaScript and CSS - Immutable cache (Vite content-hashes these)
# Since filenames include content hash, we can cache forever
# When index.html updates, it will reference new hashed files
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Fonts - Long cache (Vite content-hashes these)
/assets/*.woff
  Cache-Control: public, max-age=31536000, immutable

/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# Images - Long cache (content-addressed)
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=31536000, immutable

/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Fallback for any other files in assets
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
