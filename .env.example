# =====================================================
# AUDACIOUS MONEY - FRONTEND
# Environment Variables
# =====================================================
# Copy this file to .env and fill in your actual values
# These are PUBLIC variables (safe to expose in browser)
# Vite only exposes variables prefixed with VITE_
# =====================================================

# =====================================================
# API ENDPOINTS
# =====================================================
# Backend API URL
VITE_API_URL=http://localhost:3001

# WebSocket Sync Relay URL
VITE_SYNC_URL=ws://localhost:8080

# =====================================================
# STRIPE
# =====================================================
# Stripe publishable key (starts with pk_test_ or pk_live_)
# This is SAFE to expose in the frontend
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# =====================================================
# APPLICATION
# =====================================================
# App name
VITE_APP_NAME=Audacious Money

# App environment
VITE_APP_ENV=development  # development | staging | production

# =====================================================
# FEATURES FLAGS (Optional)
# =====================================================
# Enable debug mode (shows extra logging in console)
VITE_DEBUG_MODE=false

# Enable analytics (if you add analytics later)
VITE_ANALYTICS_ENABLED=false

# =====================================================
# THIRD-PARTY SERVICES (Optional)
# =====================================================
# Sentry DSN for frontend error tracking (leave blank to disable)
VITE_SENTRY_DSN=

# =====================================================
# DEVELOPMENT ONLY
# =====================================================
# Mock API responses (useful for offline development)
VITE_MOCK_API=false

# Disable encryption (NEVER use in production - for testing only)
VITE_DISABLE_ENCRYPTION=false
