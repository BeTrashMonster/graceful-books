# =====================================================
# AUDACIOUS MONEY - FRONTEND (PRODUCTION)
# Environment Variables
# =====================================================
# Production environment configuration
# These are PUBLIC variables (safe to expose in browser)
# Vite only exposes variables prefixed with VITE_
# =====================================================

# =====================================================
# API ENDPOINTS
# =====================================================
# Backend API URL (PRODUCTION - HTTPS only)
VITE_API_URL=https://api.audacious.money

# WebSocket Sync Relay URL (PRODUCTION - WSS only)
VITE_SYNC_URL=wss://sync.audacious.money

# =====================================================
# STRIPE
# =====================================================
# Stripe LIVE publishable key (starts with pk_live_)
# This is SAFE to expose in the frontend
# TODO: Replace with actual Stripe live key from dashboard
VITE_STRIPE_PUBLIC_KEY=pk_live_51QAb8kDAS9U3cd2IJbZUErA5r9RymOJHLivsvpjRG0DCWIcuRFAvC2lenopH1SDGE0NQDrAMw9PqP2pwqoliYYfN00e3dg3eag

# =====================================================
# APPLICATION
# =====================================================
# App name
VITE_APP_NAME=Audacious Money

# App environment
VITE_APP_ENV=production

# =====================================================
# FEATURES FLAGS
# =====================================================
# Disable debug mode in production
VITE_DEBUG_MODE=false

# Enable analytics in production (if configured)
VITE_ANALYTICS_ENABLED=false

# =====================================================
# THIRD-PARTY SERVICES
# =====================================================
# Sentry DSN for frontend error tracking (optional)
VITE_SENTRY_DSN=

# =====================================================
# PRODUCTION SECURITY
# =====================================================
# Mock API MUST be disabled in production
VITE_MOCK_API=false

# Encryption MUST be enabled in production
VITE_DISABLE_ENCRYPTION=false
