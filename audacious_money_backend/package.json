{
  "name": "audacious-money-backend",
  "version": "0.1.0",
  "description": "Backend API for Audacious Money platform",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "npm run migrate:up && node --import tsx src/index.ts",
    "start:no-migrate": "node --import tsx src/index.ts",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status",
    "db:setup": "npm run migrate:up",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ratchet": "bash scripts/ts-ratchet.sh"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@node-rs/argon2": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "hono": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "8.11.3",
    "postmark": "^4.0.7",
    "stripe": "20.4.1",
    "tsx": "^4.7.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  }
}
