{
  "name": "audacious-money-backend",
  "version": "0.1.0",
  "description": "Backend API for Audacious Money platform",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status",
    "db:setup": "npm run migrate:up"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "pg": "^8.11.3",
    "@node-rs/argon2": "^1.8.0",
    "zod": "^3.22.4",
    "tsx": "^4.7.0",
    "@hono/node-server": "^1.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "bun-types": "latest"
  }
}
