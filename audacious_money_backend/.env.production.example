# Production Environment Variables - Audacious Money Backend
# Copy to .env.production and fill in actual values
# NEVER commit .env.production to Git!

################################################################################
# ENVIRONMENT
################################################################################

NODE_ENV=production
PORT=3001

################################################################################
# DATABASE (from Digital Ocean Database dashboard)
################################################################################

# IMPORTANT: Use the POOLED connection string from Digital Ocean
# Format: postgresql://doadmin:[PASSWORD]@[HOST]:25060/audacious_money_production?sslmode=require&pool=audacious-money-pool
#
# Steps to get this:
# 1. Go to Digital Ocean → Databases → Your Database → Connection Pools
# 2. Copy the connection string from the pool you created
# 3. Ensure it includes: ?sslmode=require
#
# Example:
# DATABASE_URL=postgresql://doadmin:XXXXXX@db-postgresql-nyc3-12345.ondigitalocean.com:25060/audacious_money_production?sslmode=require&pool=audacious-money-pool

DATABASE_URL=postgresql://doadmin:[PASSWORD]@[HOST]:25060/audacious_money_production?sslmode=require&pool=audacious-money-pool

################################################################################
# JWT SECRETS (generate with: openssl rand -hex 32)
################################################################################

# User JWT secret - used for regular user authentication
# CRITICAL: Generate a new secret, do NOT use the example below
JWT_SECRET=[GENERATE_NEW_SECRET_WITH_OPENSSL_RAND_HEX_32]

# User JWT expiration
JWT_USER_EXPIRY=7d

# Admin JWT expiration (shorter for security)
JWT_ADMIN_EXPIRY=24h

################################################################################
# STRIPE (get from Stripe dashboard - PRODUCTION mode)
################################################################################

# Stripe Secret Key (starts with sk_live_)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_[YOUR_STRIPE_SECRET_KEY]

# Stripe Webhook Secret (starts with whsec_)
# Get from: https://dashboard.stripe.com/webhooks (created in Task 6.3)
STRIPE_WEBHOOK_SECRET=whsec_[FROM_TASK_6.3]

# Stripe API Version (should match what you tested with)
# See: https://stripe.com/docs/api/versioning
STRIPE_API_VERSION=2024-11-20.acacia

################################################################################
# POSTMARK (for transactional emails)
################################################################################

# Postmark Server API Token
# Get from: https://postmarkapp.com → Servers → Your Server → API Tokens
# NOTE: Domain must be verified in Postmark before sending
POSTMARK_SERVER_TOKEN=[YOUR_POSTMARK_SERVER_TOKEN]

# From email address (can be any address @audacious.money after domain verification)
POSTMARK_FROM_EMAIL=noreply@audacious.money

# From name (appears in email client)
POSTMARK_FROM_NAME=Audacious Money

# Support email (for user replies - set up email forwarding in Cloudflare)
SUPPORT_EMAIL=support@audacious.money

################################################################################
# APPLICATION URLS
################################################################################

# Main application URL (user-facing app)
APP_URL=https://app.audacious.money

# Admin dashboard URL
ADMIN_URL=https://admin.audacious.money

# Backend API URL (this server)
API_URL=https://api.audacious.money

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://app.audacious.money,https://admin.audacious.money

################################################################################
# RATE LIMITING
################################################################################

# Rate limit window in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Authentication rate limit (login/signup attempts per window)
AUTH_RATE_LIMIT_MAX=5

################################################################################
# SECURITY
################################################################################

# Bcrypt rounds for password hashing (10-12 recommended)
# Higher = more secure but slower (exponential)
BCRYPT_ROUNDS=12

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=[GENERATE_NEW_SECRET]

# Session expiration (in milliseconds)
SESSION_EXPIRY_MS=86400000

# Support session expiration (how long support access lasts)
SUPPORT_SESSION_EXPIRY_MS=3600000

################################################################################
# LOGGING
################################################################################

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json, pretty
# Use json for production (better for log aggregation)
# Use pretty for development (easier to read)
LOG_FORMAT=json

################################################################################
# OPTIONAL: MONITORING & OBSERVABILITY
################################################################################

# Sentry DSN (for error tracking)
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# New Relic License Key (for APM)
# NEW_RELIC_LICENSE_KEY=xxxxx

# LogDNA/Mezmo Ingestion Key (for centralized logging)
# LOGDNA_INGESTION_KEY=xxxxx

################################################################################
# OPTIONAL: FEATURE FLAGS
################################################################################

# Enable email verification requirement
REQUIRE_EMAIL_VERIFICATION=true

# Enable support session feature
ENABLE_SUPPORT_SESSIONS=true

# Enable charity donations
ENABLE_CHARITY_DONATIONS=true

# Enable affiliate program
ENABLE_AFFILIATES=true

################################################################################
# NOTES
################################################################################

# Security Checklist:
# [ ] All secrets are randomly generated (not defaults)
# [ ] DATABASE_URL uses sslmode=require
# [ ] DATABASE_URL uses connection pool
# [ ] .env.production is in .gitignore
# [ ] Stripe keys are from PRODUCTION mode (sk_live_)
# [ ] Postmark domain is verified (audacious.money)
# [ ] CORS origins are production domains only
# [ ] JWT secrets are strong and unique
# [ ] Rate limits are configured appropriately
# [ ] Log level is set to 'info' or 'warn' (not 'debug')

# After filling in values:
# 1. Rename to .env.production (remove .example)
# 2. Verify it's in .gitignore
# 3. Test connection: bun run scripts/verify-db-connection.ts
# 4. Never share or commit this file!
