# Security-Focused NPM Configuration
# Phase 2.3 - SLSA Level 2 Supply Chain Security
# See: docs/security/AGENTIC_AI_SECURITY_ROADMAP.md

# Enforce lockfile - prevents unexpected dependency changes
package-lock=true

# Use exact versions - no semver ranges
save-exact=true

# Always run audit on install
audit=true

# Disable funding messages (reduces noise)
fund=false

# Set audit level to fail on moderate+ vulnerabilities
audit-level=moderate

# Disable update notifier (security: reduces external calls)
update-notifier=false

# Strict peer dependencies
strict-peer-deps=true

# Require engine compatibility
engine-strict=true

# Don't run lifecycle scripts from untrusted packages during install
ignore-scripts=false

# Log level for audit
loglevel=warn
