# Sync Relay Environment Variables
# WebSocket server for real-time data synchronization

# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration
# IMPORTANT: Must be the SAME connection pool URL as backend
# Format: postgresql://username:password@host:25060/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:25432/audacious_money

# JWT Configuration
# CRITICAL: Must match backend JWT_SECRET exactly
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-must-match-backend
